{
  "name": "fries-consulting-services",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-content.mjs",
    "dev": "npm run generate && vite",
    "build": "npm run generate && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr-dist && node scripts/prerender.mjs",
